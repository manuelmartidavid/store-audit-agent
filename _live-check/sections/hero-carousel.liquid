    { "type": "range", "id": "autoplay_speed", "min": 2000, "max": 8000, "step": 500, "default": 5000, "label": "t:labels.autoplay_speed" }
  ],
  "presets": [
    {
      "name": "t:general.hero_carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "background_color": "#1e3a5f",
