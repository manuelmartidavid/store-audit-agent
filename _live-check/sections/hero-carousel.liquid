        { "type": "color", "id": "primary_btn_fg", "default": "#1f2937", "label": "t:labels.primary_btn_fg" },
        { "type": "text", "id": "secondary_button_label", "label": "t:labels.secondary_button" },
        { "type": "url", "id": "secondary_button_link", "label": "t:labels.secondary_button_link" },
        { "type": "color", "id": "secondary_btn_color", "default": "#ffffff", "label": "t:labels.secondary_btn_color" },
        { "type": "header", "content": "t:labels.dark_mode_colors" },
        { "type": "color", "id": "dark_background_color", "label": "t:labels.background_color" },
        { "type": "color", "id": "dark_text_color", "label": "t:labels.text_color" },
        { "type": "color", "id": "dark_primary_btn_bg", "label": "t:labels.primary_btn_bg" },
        { "type": "color", "id": "dark_primary_btn_fg", "label": "t:labels.primary_btn_fg" }
      ]
    }
  ],
  "settings": [
    { "type": "font_picker", "id": "text_font", "default": "work_sans_n4", "label": "t:labels.text_font" },
