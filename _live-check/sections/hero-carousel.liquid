        { "type": "text", "id": "subtitle", "label": "t:labels.subtitle", "default": "New arrivals weekly" },
        { "type": "textarea", "id": "description", "label": "t:labels.description", "default": "Singles, sealed packs, graded cards and more. In-store and online." },
