<div class="collection-page">
  <div class="collection-page__header">
    <div>
      <h1 class="collection-page__title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <p class="collection-page__description">{{ collection.description }}</p>
      {% endif %}
    </div>
    <p class="collection-page__count">{{ 'collections.results' | t: count: collection.products_count }}</p>
  </div>

  <div class="collection-page__body">

    {% if collection.filters.size > 0 %}
      <button class="btn btn--outline collection-page__filter-toggle" data-filter-toggle aria-expanded="false" aria-controls="collection-filters">
        {{ 'collections.filter' | t }}
        {% assign active_count = 0 %}
        {% for filter in collection.filters %}
          {% assign active_count = active_count | plus: filter.active_values.size %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value or filter.max_value.value %}
              {% assign active_count = active_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if active_count > 0 %}
          <span class="collection-page__filter-badge">{{ active_count }}</span>
        {% endif %}
      </button>
    {% endif %}

    <aside class="collection-page__filters" id="collection-filters" hidden>
      <form method="get" action="{{ collection.url }}" id="FilterForm">
        <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">

        {% for filter in collection.filters %}
          <details class="filter-group" open>
            <summary class="filter-group__label">
              {{ filter.label }}
              {% if filter.active_values.size > 0 %}
                <span class="filter-group__active-dot"></span>
              {% endif %}
              <svg class="filter-group__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>

            {% if filter.type == 'list' %}
              <div class="filter-group__options">
                {% for value in filter.values %}
                  <label class="filter-option{% if value.count == 0 and value.active == false %} filter-option--disabled{% endif %}">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      form="FilterForm"
                    >
                    <span class="filter-option__label">{{ value.label }}</span>
                    <span class="filter-option__count">{{ value.count }}</span>
                  </label>
                {% endfor %}
              </div>

            {% elsif filter.type == 'price_range' %}
              {% assign min_val = filter.min_value.value | default: 0 | divided_by: 100 %}
              {% assign max_val = filter.max_value.value | default: filter.range_max | divided_by: 100 %}
              {% assign range_max = filter.range_max | divided_by: 100 %}
              <div class="filter-group__price">
                <div class="filter-price__inputs">
                  <div class="filter-price__field">
                    <span class="filter-price__currency">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      id="Filter-{{ filter.label | handleize }}-min"
                      value="{{ min_val }}"
                      min="0"
                      max="{{ range_max }}"
                      placeholder="0"
                      form="FilterForm"
                    >
                  </div>
                  <span class="filter-price__sep">—</span>
                  <div class="filter-price__field">
                    <span class="filter-price__currency">{{ cart.currency.symbol }}</span>
                    <input
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      id="Filter-{{ filter.label | handleize }}-max"
                      value="{{ max_val }}"
                      min="0"
                      max="{{ range_max }}"
                      placeholder="{{ range_max }}"
                      form="FilterForm"
                    >
                  </div>
                </div>
              </div>
            {% endif %}
          </details>
        {% endfor %}

        <div class="filter-group__actions">
          <button type="submit" class="btn btn--primary">{{ 'collections.apply_filters' | t }}</button>
          <a href="{{ collection.url }}" class="filter-group__clear-all">{{ 'collections.clear_all' | t }}</a>
        </div>
      </form>
    </aside>

    <div class="collection-page__main">

      <div class="collection-page__toolbar">
        {% assign has_active = false %}
        {% for filter in collection.filters %}
          {% if filter.active_values.size > 0 %}{% assign has_active = true %}{% endif %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value or filter.max_value.value %}{% assign has_active = true %}{% endif %}
          {% endif %}
        {% endfor %}

        {% if has_active %}
          <div class="active-filters">
            {% for filter in collection.filters %}
              {% for value in filter.active_values %}
                <a href="{{ value.url_to_remove }}" class="active-filter-pill">
                  {{ value.label }}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </a>
              {% endfor %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value or filter.max_value.value %}
                  <a href="{{ filter.url_to_remove }}" class="active-filter-pill">
                    {{ filter.label }}
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
            <a href="{{ collection.url }}" class="active-filters__clear">{{ 'collections.clear_all' | t }}</a>
          </div>
        {% endif %}

        {% if section.settings.enable_sort %}
          <div class="collection-page__sort">
            <label for="collection-sort" class="collection-page__sort-label">{{ 'collections.sort_by' | t }}</label>
            <select id="collection-sort" class="collection-page__sort-select" data-collection-sort>
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      </div>

      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products.size > 0 %}
          <div class="collection-page__grid">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>
        {% else %}
          <p class="collection-page__empty">{{ 'collections.no_results' | t }}</p>
        {% endif %}

        {% if paginate.pages > 1 %}
          <div class="collection-page__pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}

    </div>
  </div>
</div>

{% stylesheet %}
.collection-promo {
  /* No min-height on an ancestor and no placeholder: the box does not exist
     until the timer fires, which is the whole point of the defect. */
  min-height: 320px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.375rem;
  padding: 1.5rem 1.25rem;
  margin-bottom: 1.5rem;
  border-radius: var(--style-border-radius);
  background: var(--color-primary);
  color: #fff;
}
.collection-promo__kicker {
  margin: 0;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.75;
}
.collection-promo__headline { margin: 0; font-size: 1.25rem; font-weight: 800; line-height: 1.25; }
.collection-promo__body { margin: 0; font-size: 0.9375rem; line-height: 1.5; opacity: 0.85; }
.collection-promo__link {
  align-self: flex-start;
  margin-top: 0.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: #fff;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.collection-page {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 2rem var(--page-margin) 3rem;
}
.collection-page__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.collection-page__title { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 0.25rem; }
.collection-page__description { font-size: 0.9375rem; color: #6b7280; margin: 0; }
.collection-page__count { font-size: 0.875rem; color: #9ca3af; margin: 0; white-space: nowrap; }

.collection-page__filter-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}
.collection-page__filter-badge {
  background: var(--color-primary);
  color: #fff;
  font-size: 0.6875rem;
  font-weight: 700;
  min-width: 1.125rem;
  height: 1.125rem;
  border-radius: 9999px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 0.2rem;
}
@media (min-width: 768px) { .collection-page__filter-toggle { display: none; } }

.collection-page__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 768px) {
  .collection-page__body {
    grid-template-columns: 14rem 1fr;
    align-items: start;
  }
}

/* Filters sidebar */
.collection-page__filters {
  display: none;
}
.collection-page__filters[open],
.collection-page__filters:not([hidden]) {
  display: block;
}
@media (min-width: 768px) {
  .collection-page__filters {
    display: block !important;
    position: sticky;
    top: 6rem;
  }
}

.filter-group {
  border-bottom: 1px solid #e5e7eb;
  padding: 0.75rem 0;
}
.filter-group__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-foreground);
  cursor: pointer;
  list-style: none;
  padding: 0.25rem 0;
}
.filter-group__label::-webkit-details-marker { display: none; }
.filter-group__active-dot {
  width: 0.4375rem;
  height: 0.4375rem;
  border-radius: 9999px;
  background: var(--color-primary);
  flex-shrink: 0;
}
.filter-group__chevron { flex-shrink: 0; transition: transform 0.2s; margin-left: auto; }
details[open] .filter-group__chevron { transform: rotate(180deg); }

.filter-group__options {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  padding-top: 0.75rem;
}
.filter-option {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-size: 0.875rem;
  color: var(--color-foreground);
}
.filter-option--disabled { opacity: 0.4; cursor: not-allowed; }
.filter-option input[type="checkbox"] { accent-color: var(--color-primary); width: 1rem; height: 1rem; flex-shrink: 0; }
.filter-option__label { flex: 1; }
.filter-option__count { font-size: 0.8125rem; color: #9ca3af; }

.filter-group__price { padding-top: 0.75rem; }
.filter-price__inputs { display: flex; align-items: center; gap: 0.5rem; }
.filter-price__field {
  display: flex;
  align-items: center;
  border: 1px solid #d1d5db;
  border-radius: var(--style-border-radius-inputs);
  overflow: hidden;
  flex: 1;
}
.filter-price__currency {
  padding: 0 0.375rem;
  font-size: 0.875rem;
  color: #6b7280;
  background: #f9fafb;
  border-right: 1px solid #d1d5db;
  align-self: stretch;
  display: flex;
  align-items: center;
}
.filter-price__field input {
  border: none;
  padding: 0.4rem 0.5rem;
  font-size: 0.875rem;
  width: 100%;
  min-width: 0;
  color: var(--color-foreground);
  font-family: inherit;
}
.filter-price__field input:focus { outline: none; }
.filter-price__sep { color: #9ca3af; flex-shrink: 0; }

.filter-group__actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-top: 1.25rem;
}
.filter-group__clear-all {
  font-size: 0.875rem;
  color: #6b7280;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Active filter pills */
.collection-page__toolbar {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
  justify-content: space-between;
}
.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  flex: 1;
}
.active-filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.3rem 0.625rem;
  background: var(--color-primary);
  color: #fff;
  border-radius: 9999px;
  font-size: 0.8125rem;
  font-weight: 500;
  text-decoration: none;
  transition: opacity 0.15s;
}
.active-filter-pill:hover { opacity: 0.85; }
.active-filters__clear {
  font-size: 0.8125rem;
  color: #6b7280;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.collection-page__sort { display: flex; align-items: center; gap: 0.5rem; }
.collection-page__sort-label { font-size: 0.875rem; color: #6b7280; white-space: nowrap; }
.collection-page__sort-select {
  padding: 0.375rem 0.625rem;
  border: 1px solid #d1d5db;
  border-radius: var(--style-border-radius-inputs);
  font-size: 0.875rem;
  color: var(--color-foreground);
  background: #fff;
  font-family: inherit;
}
html[data-theme="dark"] .collection-page__sort-select {
  background: #1f2937;
  border-color: #374151;
}
.collection-page__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}
@media (min-width: 768px) {
  .collection-page__grid { grid-template-columns: repeat(3, 1fr); }
}
.collection-page__empty { font-size: 1rem; color: #6b7280; padding: 3rem 0; text-align: center; }
.collection-page__pagination {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 2.5rem;
  flex-wrap: wrap;
}
.collection-page__pagination a,
.collection-page__pagination span {
  padding: 0.5rem 0.875rem;
  border: 1px solid #d1d5db;
  border-radius: 0.375rem;
  font-size: 0.875rem;
  text-decoration: none;
  color: var(--color-foreground);
  transition: border-color 0.15s, background 0.15s;
}
.collection-page__pagination a:hover { border-color: var(--color-primary); }
.collection-page__pagination .current { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
{% endstylesheet %}

{% javascript %}
(function() {
  // Late seasonal promo. Injected from JS after the grid has painted, with
  // no space reserved for it, so everything below moves down.
  // Tuning knobs for the planting loop: delay and PROMO_MIN_HEIGHT in the
  // stylesheet. Re-run scripts/measure.py after changing either.
  var promoHost = document.querySelector('.collection-page');
  if (promoHost) {
    setTimeout(function() {
      var promo = document.createElement('div');
      promo.className = 'collection-promo';
      promo.innerHTML =
        '<p class="collection-promo__kicker">This week only</p>' +
        '<p class="collection-promo__headline">Weekly drop: new singles and sealed</p>' +
        '<p class="collection-promo__body">Fresh inventory hits the floor every Friday at noon. ' +
        'Graded, raw and sealed \u2014 first come, first served.</p>' +
        '<a class="collection-promo__link" href="/collections/all">Browse the latest</a>';
      promoHost.insertBefore(promo, promoHost.firstChild);
    }, 1400);
  }

  var sortSelect = document.querySelector('[data-collection-sort]');
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sortSelect.value);
      window.location.href = url.toString();
    });
  }

  var filterToggle = document.querySelector('[data-filter-toggle]');
  var filtersEl = document.getElementById('collection-filters');
  if (filterToggle && filtersEl) {
    filterToggle.addEventListener('click', function() {
      var isHidden = filtersEl.hidden;
      filtersEl.hidden = !isHidden;
      filterToggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    });
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 24, "step": 4, "default": 12, "label": "t:labels.products_per_page" },
    { "type": "checkbox", "id": "enable_sort", "default": true, "label": "t:labels.enable_sort" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
