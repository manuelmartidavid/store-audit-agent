# Secrets — the storefront password lives here, never committed (sabotage-spec §gate)
.env
.env.*

# Dependencies
node_modules/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Crawl output goes to a fixtures dir the operator chooses; the default one is
# working output, not source.
/fixtures/

# Planting assets — regenerable from planting/make_hero_p01.py --seed (decision
# 12 provenance is the printed sha256, not the blob).
/*.png
/*.jpg

# Bridge/host litter, not project state.
/_to_delete/

# Derived from fixtures + prompts; regenerable, and the rendered prompts are
# ~440 KB each. The run JSON in runs/*.json is a result and IS committed.
/packs/
/runs/*.rendered.md

# Git lock files the device bridge cannot unlink (host quirk, not project state).
/.tmplocks/

# Fixture archives — the durable backup of a capture. Large, and regenerable
# from the fixture, but the fixture itself is not regenerable (the store has
# drifted). Copy these somewhere off this machine; the manifest hash inside is
# the same pin the labels carry.
/archives/
